{
  "name": "weather-for-grown-ups",
  "version": "0.5.5",
  "mcpName": "io.github.janhelcl/weather-for-grown-ups",
  "description": "Unified agent-native access to global and regional NOAA/DWD/Météo-France/ECMWF atmospheric forecasts, ensembles, reforecasts, and historical GFS analysis.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhelcl/weather-for-grown-ups.git"
  },
  "bugs": {
    "url": "https://github.com/janhelcl/weather-for-grown-ups/issues"
  },
  "homepage": "https://github.com/janhelcl/weather-for-grown-ups#readme",
  "keywords": [
    "gfs",
    "aigfs",
    "aigefs",
    "hgefs",
    "gefs",
    "ifs",
    "aifs",
    "aifs-ens",
    "ecmwf",
    "dwd",
    "icon-d2",
    "icon-d2-eps",
    "arome",
    "pe-arome",
    "meteo-france",
    "noaa",
    "weather",
    "meteorology",
    "grib2",
    "mcp",
    "model-context-protocol"
  ],
  "files": [
    "dist",
    "README.md",
    "docs",
    "skills",
    "server.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "weather-for-grown-ups": "./dist/entry.js",
    "wfg": "./dist/cli.js",
    "wfg-mcp": "./dist/mcp-cli.js",
    "wfg-mcp-http": "./dist/mcp-http.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "mcp:http": "tsx src/mcp-http.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node dist/entry.js --help && node dist/cli.js --help && node dist/cli.js catalog --help && node dist/cli.js catalog --search cloud --sections fields --classification raw --limit 3 --json && node dist/cli.js query --help && node dist/cli.js diagnose --help && node dist/cli.js align --help && node dist/cli.js verify --help && node dist/cli.js analogs --help && node dist/cli.js index --help",
    "test:live": "tsx scripts/run-live-smoke.ts live-smoke.ts",
    "test:live:bundled": "tsx scripts/run-live-smoke.ts live-smoke-bundled-decoder.ts",
    "test:live:s3": "tsx scripts/run-live-smoke.ts live-smoke-s3.ts",
    "test:live:history": "tsx scripts/run-live-smoke.ts live-smoke-history.ts",
    "test:live:gfs-routing": "npm run test:live:gfs-operational-parity && npm run test:live:gfs-analysis-routing",
    "test:live:ifs": "tsx scripts/run-live-smoke.ts live-smoke-ifs.ts",
    "test:live:aifs": "tsx scripts/run-live-smoke.ts live-smoke-aifs.ts",
    "test:live:gefs": "tsx scripts/run-live-smoke.ts live-smoke-gefs.ts && tsx scripts/run-live-smoke.ts live-smoke-gefs-points-timeseries.ts && tsx scripts/run-live-smoke.ts live-smoke-gefs-points-bundle-timeseries.ts && tsx scripts/run-live-smoke.ts live-smoke-gefs-transect.ts",
    "test:live:align": "tsx scripts/run-live-smoke.ts live-smoke-align.ts",
    "test:live:area": "tsx scripts/run-live-smoke.ts live-smoke-area.ts",
    "test:live:all": "npm run test:live:bundled && npm run test:live:s3 && npm run test:live:aigfs && npm run test:live:aigefs && npm run test:live:hgefs && npm run test:live:icon-d2 && npm run test:live:icon-d2-eps && npm run test:live:arome && npm run test:live:gfs-routing && npm run test:live:ifs && npm run test:live:aifs && npm run test:live:aifs-ens && npm run test:live:gefs && npm run test:live:gefs-reforecast && npm run test:live:align && npm run test:live:area && npm run test:live:igra && npm run test:live:igra-skill",
    "test:distribution": "node scripts/check-release-metadata.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:distribution && npm run typecheck && npm test && npm run build && npm run test:smoke",
    "test:live:gfs-operational-parity": "tsx scripts/run-live-smoke.ts live-smoke-gfs-operational-parity.ts",
    "test:live:gfs-analysis-routing": "tsx scripts/run-live-smoke.ts live-smoke-gfs-analysis-routing.ts",
    "test:live:gfs-archive-equivalence": "tsx scripts/run-live-smoke.ts live-smoke-gfs-equivalence.ts",
    "test:live:igra": "tsx scripts/run-live-smoke.ts live-smoke-igra-verification.ts",
    "test:live:igra-skill": "tsx scripts/run-live-smoke.ts live-smoke-igra-skill.ts",
    "test:live:gefs-reforecast": "tsx scripts/run-live-smoke.ts live-smoke-gefs-reforecast.ts",
    "test:live:aigfs": "tsx scripts/run-live-smoke.ts live-smoke-aigfs.ts",
    "test:live:aigefs": "tsx scripts/run-live-smoke.ts live-smoke-aigefs.ts",
    "test:live:hgefs": "tsx scripts/run-live-smoke.ts live-smoke-hgefs.ts",
    "test:live:aifs-ens": "tsx scripts/run-live-smoke.ts live-smoke-aifs-ens.ts",
    "test:live:icon-d2": "tsx scripts/run-live-smoke.ts live-smoke-icon-d2.ts",
    "test:live:icon-d2-eps": "tsx scripts/run-live-smoke.ts live-smoke-icon-d2-eps.ts",
    "test:live:arome": "tsx scripts/run-live-smoke.ts live-smoke-arome.ts",
    "test:live:pe-arome": "tsx scripts/run-live-smoke.ts live-smoke-pe-arome.ts"
  },
  "dependencies": {
    "@mattnucc/gribberish": "^1.6.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^14.0.0",
    "execa": "^9.0.0",
    "zod": "^4.0.0",
    "netcdfjs": "^4.0.0",
    "seek-bzip": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
